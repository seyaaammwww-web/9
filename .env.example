# Required
BOT_TOKEN=

# Access control
ADMIN_ID=
ALLOWED_USER_IDS=

# Optional Telegram / mailbox proxies
TELEGRAM_PROXY_URL=
MAILDEV_PROXY_URL=

# Container-friendly defaults (raise on a large VPS)
NUM_WORKERS=2
POOL_SIZE_PER_USER=2
TARGET_POOL_SIZE=2
PREWARM_WORKERS=1
POOL_ACQUIRE_WAIT=90
MAX_LIVE_POOLED=2

# Timeouts
SETUP_TIMEOUT=180
GENERATION_ATTEMPT_TIMEOUT=120
POSE_GENERATION_TIMEOUT=180
BULK_GENERATION_TIMEOUT=240
VIDEO_GENERATION_TIMEOUT=180
BROWSER_REUSE_LIMIT=5
BULK_MAX_BROWSER_REUSE=30
BULK_GUAVA_REUSE=1
USE_ABSOLUTE_PROMPTS=1
MAX_SINGLE_REFERENCES=8

# Queue
USER_COOLDOWN=0
COOLDOWN_USER_IDS=
STRICT_QUEUE_USER_IDS=
